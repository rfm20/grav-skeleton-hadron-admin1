<style>
/* ===== ROOT VARIABLES ===== */
:root {
  --primary-dark: #14532d;
  --primary: #15803d;
  --primary-light: #d1fae5;
  --accent: #22c55e;
  --bg-white: #ffffff;
  --text-dark: #1f2937;
  --radius-card: 22px;
  --shadow-soft: 0 4px 12px rgba(0,0,0,0.12);
  --shadow-hover: 0 10px 26px rgba(34,197,94,0.25);
}

/* ===== RESET ===== */
*,
*::before,
*::after {
  box-sizing: border-box;
}

a {
  color: inherit !important;
  text-decoration: none !important;
}

body {
  margin: 0;
  padding: 0;
  background: #f9fafb;
  line-height: 1.6;
}

/* ===== HEADER SECTION ===== */
.berita-section {
  text-align: center;
  padding: clamp(24px, 6vw, 40px) 0 30px;
}

.berita-section h1 {
  font-size: clamp(1.6rem, 5vw, 2rem);
  margin-bottom: 8px;
  color: var(--primary-dark);
  font-weight: 800;
}

.berita-section h2 {
  font-size: clamp(0.95rem, 3vw, 1.1rem);
  font-weight: 400;
  margin-bottom: clamp(24px, 6vw, 35px);
  color: var(--primary);
}

/* ===== WRAPPER PUTIH ===== */
.carousel-bg {
  width: 100%;
  background: var(--bg-white) !important;
  padding: clamp(20px, 6vw, 40px) 0;
  border-radius: clamp(14px, 4vw, 20px);
  position: relative;
}

/* ===== FORCE BG PUTIH OWL ===== */
.owl-carousel,
.owl-carousel .owl-stage-outer,
.owl-carousel .owl-stage,
.owl-carousel .owl-item {
  background: var(--bg-white) !important;
}

/* ===== NEWS CARD ===== */
.news-card {
  background: var(--bg-white);
  border-radius: var(--radius-card);
  overflow: hidden;
  border: 1.5px solid rgba(34,197,94,0.25);
  transition: 0.3s ease;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 360px;
  margin: 10px;
}

.news-card:hover {
  transform: translateY(-6px) scale(1.01);
  border-color: rgba(34,197,94,0.45);
  box-shadow: var(--shadow-hover);
}

/* ===== IMAGE ===== */
.news-card img {
  width: 100%;
  height: clamp(160px, 28vw, 200px);
  object-fit: cover;
  transition: 0.4s ease;
}

.news-card:hover img {
  transform: scale(1.08);
}

/* ===== TITLE ===== */
.news-card h4 {
  padding: 16px 18px;
  font-size: clamp(1rem, 3.5vw, 1.15rem);
  color: var(--primary-dark);
  font-weight: 700;
  text-align: center;
  flex-grow: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.35;
}

/* ===== BUTTON ===== */
.read-more {
  display: block;
  margin: 0 18px 20px;
  padding: 12px 15px;
  text-align: center;
  background: linear-gradient(135deg,#16a34a,#22c55e,#4ade80);
  color: #ffffff !important;
  font-weight: 700;
  border-radius: 12px;
  transition: 0.3s ease;
  box-shadow: 0 4px 12px rgba(34,197,94,0.35);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-size: 0.85rem;
}

.read-more:hover {
  background: linear-gradient(135deg,#0f9f43,#16a34a,#22c55e);
  transform: translateY(-3px);
}

/* ===== OWL NAVIGATION ===== */
.owl-nav button.owl-prev,
.owl-nav button.owl-next {
  background: var(--bg-white) !important;
  border-radius: 50%;
  width: clamp(40px, 8vw, 50px);
  height: clamp(40px, 8vw, 50px);
  border: 2px solid var(--primary-dark) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(22px, 5vw, 34px) !important;
  color: var(--primary-dark) !important;
  box-shadow: var(--shadow-soft);
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  transition: 0.3s ease;
  z-index: 10;
}

.owl-nav button.owl-prev:hover,
.owl-nav button.owl-next:hover {
  background: var(--primary-light) !important;
  transform: translateY(-50%) scale(1.08);
}

.owl-nav button.owl-prev {
  left: clamp(-18px, -4vw, -30px);
}

.owl-nav button.owl-next {
  right: clamp(-18px, -4vw, -30px);
}

/* ===== DOTS ===== */
.owl-dots {
  margin-top: 20px;
  text-align: center;
}

/* ===== TABLET ===== */
@media (max-width: 768px) {
  .news-card:hover {
    transform: none;
  }
}

/* ===== MOBILE ===== */
@media (max-width: 480px) {
  .news-card {
    margin: 6px;
  }

  .read-more {
    font-size: 0.8rem;
    padding: 10px 12px;
  }
}

/* ===== TOUCH DEVICE ===== */
@media (hover: none) and (pointer: coarse) {
  .news-card:hover,
  .news-card:hover img,
  .read-more:hover {
    transform: none;
    box-shadow: none;
  }
}

/* ===== PRINT ===== */
@media print {
  .owl-nav,
  .owl-dots {
    display: none !important;
  }

  .news-card {
    box-shadow: none;
    border: 1px solid #ccc;
    page-break-inside: avoid;
  }
}
</style>

<div class="berita-section">
  <h1>Berita & Dokumentasi Kegiatan</h1>
  <h2>Dinas Pemberdayaan Masyarakat dan Desa Kalimantan Barat</h2>
</div>

<!-- WRAPPER PUTIH -->
<div class="carousel-bg">

  <div class="owl-carousel">

  {% set blog = page.find('/en/blog') ?: page.find('/blog') %}
  {% set posts = blog.children.order('date','desc').slice(0,6) %}

  {% for post in posts %}
    <div class="news-card">
      {% if post.media.images|first %}
        <img src="{{ post.media.images|first.url }}" alt="">
      {% else %}
        <img src="https://via.placeholder.com/600x300?text=No+Image" alt="">
      {% endif %}

      <h4>{{ post.title }}</h4>

      <a href="{{ post.url(true) }}" class="read-more">
        Selengkapnya
      </a>
    </div>
  {% endfor %}

  </div>

</div>

<script>
$(document).ready(function(){
  $('.owl-carousel').owlCarousel({
    loop:true,
    margin:25,
    nav:true,
    dots:false,
    autoplay:true,
    autoplayTimeout:3500,
    smartSpeed:700,
    responsive:{
      0:{items:1},
      768:{items:2},
      1200:{items:3}
    }
  });
});
</script>
